# Copy to .env and fill in locally. Never commit .env or real keys.
#
# Offline-friendly default. Set to orcarouter for the hosted primary or lfm3 for
# the local fallback; fake never calls the network.
MODEL_PROVIDER=fake

# OrcaRouter primary (OpenAI-compatible)
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=tencent/hy4-preview-free
ORCAROUTER_REASONING_EFFORT=none

# Local LFM3-1.7B fallback (OpenAI-compatible chat service)
LFM3_BASE_URL=http://127.0.0.1:8080/v1
LFM3_API_KEY=
LFM3_MODEL=lfm3-1.7b

# MCP gateway (synthetic local demo). Replace the secret outside local use.
GATEWAY_ISSUER=http://127.0.0.1:8765
GATEWAY_AUDIENCE=forge-freight-gateway
GATEWAY_JWT_SECRET=replace-with-a-random-32-byte-secret
GATEWAY_DB_PATH=
GATEWAY_TENANT_ID=tenant_northwind
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765
