# Copy to .env and fill in locally. Never commit .env or real keys.
#
# Model provider: orcarouter | lfm3 | fake
MODEL_PROVIDER=orcarouter

# OrcaRouter primary (OpenAI-compatible)
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=tencent/hy4-preview-free
ORCAROUTER_REASONING_EFFORT=none

# Local LFM3-1.7B fallback (OpenAI-compatible chat service)
LFM3_BASE_URL=http://127.0.0.1:8080/v1
LFM3_API_KEY=
LFM3_MODEL=lfm3-1.7b
